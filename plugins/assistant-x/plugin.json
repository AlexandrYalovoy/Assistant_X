{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "assistant-x",
  "version": "0.4",
  "description": "Your own library of documents (PDF, scans, standards, books) on your PC: search by words and meaning, answers citing the code and the page. The plugin installs and connects Assistant X.",
  "author": {
    "name": "Alexandr Yalovoy"
  },
  "homepage": "https://github.com/AlexandrYalovoy/Assistant_X",
  "repository": "https://github.com/AlexandrYalovoy/Assistant_X",
  "license": "AGPL-3.0-or-later",
  "keywords": [
    "documents",
    "library",
    "rag",
    "mcp",
    "search",
    "citations"
  ],
  "extensions": {
    "com.openai": {
      "onboardingSkill": "./skills/assistant-x-setup/SKILL.md",
      "interface": {
        "displayName": "Assistant X"
      }
    }
  }
}
