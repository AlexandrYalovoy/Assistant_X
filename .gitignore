# A workspace is the user's data, never part of the code (assistant_x/core/workspace.py); these names (at the root
# only: assistant_x/templates holds the templates of index/ and assistant_x.toml) keep one made here by mistake out of Git
/inbox/
/library/
/index/
/reports/
/.assistant_x/
/assistant_x.toml
/assistant_x.local.toml
/questions*.md
/eval_baseline.json

# Debug reports and dumps made by hand
/debug/

# The portable programs of an offline media (Tesseract, LibreOffice, 7-Zip)
/programs/

# The Python environment of the package and the build
.venv/
*.egg-info/
/build/
/dist/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local settings of Claude and the notes with the paths of this PC
.claude/
/CLAUDE.local.md
/private/

# Generated by python -m tests.corpus.report (the baseline, tests/corpus/baseline.json, is kept)
/tests/corpus/last_report.json
