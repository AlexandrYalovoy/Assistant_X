{
  "_comment": "The hierarchy of the documents of the oil and gas profile (core/hierarchy.py): the general levels with the designations of Russian and international documents; the documents of the company (ТТТ, ТТР, ТПР, П1-…, М-…) rank with the national standards, after them. The user's own hierarchy.json in the workspace is above this one.",
  "levels": [
    {"rank": 1, "name": {"en": "Constitution", "ru": "Конституция"}, "patterns": ["(?i)^(constitution|конституци)"]},
    {"rank": 2, "name": {"en": "Codes and laws, decrees and government resolutions", "ru": "Кодексы и законы, указы и постановления правительства"}, "patterns": ["^(Федеральный закон|Закон|\\d+-ФЗ|[А-Яа-я ]*[Кк]одекс|Указ|Постановление|Распоряжение)", "(?i)^(code|act|law|decree|directive)\\b"]},
    {"rank": 3, "name": {"en": "Technical regulations", "ru": "Технические регламенты"}, "patterns": ["^(ТР ТС|ТР ЕАЭС|ТР РК|Технический регламент)", "(?i)^technical regulation"]},
    {"rank": 4, "name": {"en": "International standards and register rules", "ru": "Международные стандарты и правила регистров"}, "patterns": ["^(ISO|IEC|ISO/IEC|ИСО|МЭК|IMO|DNV|ABS|РМРС|Правила РС|Правила Российского морского)\\b"]},
    {"rank": 5, "name": {"en": "National standards", "ru": "ГОСТ и ГОСТ Р"}, "patterns": ["^(ГОСТ|ПНСТ|GOST|API|ASME|ASTM|DIN|NACE|ANSI|BS|EN|NFPA|IEEE)\\b", "^СТ РК\\b","^(Изменение|Amendment)\\b.*\\b(ГОСТ|GOST)\\b"]},
    {"rank": 5.5, "name": {"en": "Company documents", "ru": "Документы компании"}, "patterns": ["^(ТТТ|ТТР|ТПР|ТТ-|ОСК|П\\d-|М-\\d|ВП\\d)", "^Технологический регламент"]},
    {"rank": 6, "name": {"en": "Sets of rules and safety rules", "ru": "СП и правила безопасности"}, "patterns": ["^(СП|СНиП|СанПиН|ПБ|ФНП|ППБ|ПУЭ|НПБ|Правила устройства|Федеральные нормы и правила|Правила безопасности|Правила противопожарного)\\b", "^(СН РК|СП РК|НП РК|НП к СП РК|МСН|МСП)\\b","^Правила\\b"]},
    {"rank": 7, "name": {"en": "Industry documents", "ru": "Отраслевые РД"}, "patterns": ["^(ОСТ|РД|ТУ|ВНТП|НТП|РДС РК|НТП РК)\\b"]},
    {"rank": 8, "name": {"en": "Organization standards", "ru": "СТО"}, "patterns": ["^(СТО|ВРД|ВСН|СТП|МИ|DEP)\\b"]},
    {"rank": 9, "name": {"en": "Methodical documents", "ru": "Методики"}, "patterns": ["^(МД|МДС|МУ|МР|Р|РМГ|ЕТКС|ИТС)\\b", "^(МДС|МУ|МР) РК\\b","^(Методические|Методика|Руководство|Инструкция|Типовая инструкция)"]},
    {"rank": 10, "name": {"en": "Handbooks, books and articles", "ru": "Справочники"}, "patterns": []}
  ],
  "shelves": {"L": 10, "J": 10, "P": 10, "E": 10, "X": 10, "R": 6},
  "unplaced": 9
}
